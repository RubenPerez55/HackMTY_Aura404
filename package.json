{
  "name": "banorte-shockabsorber",
  "version": "1.0.0",
  "private": true,
  "description": "Banorte ShockAbsorber - HackMTY Aura404",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix mcp-agent run serve",
    "build": "npm --prefix mcp-agent run build",
    "build:all": "npm --prefix mcp-agent run build && npm --prefix frontend run build",
    "probe": "npm --prefix mcp-agent run probe --",
    "smoke:banking": "npm --prefix mcp-agent run smoke:banking",
    "smoke:backend": "npm --prefix mcp-agent run smoke:backend",
    "smoke:all": "npm run smoke:banking && npm run smoke:backend",
    "validate:motor": "motor/.venv/bin/python motor/validar_motor.py",
    "data:reset": "git checkout data/",
    "test:flow": "npm --prefix mcp-agent run test:flow --"
  }
}
