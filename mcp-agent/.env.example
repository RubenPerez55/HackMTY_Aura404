# ========== LLM backend (Gemini directo) ==========
# Gemini usa la API compatible con OpenAI de Google.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=tu-api-key-de-gemini
# Modelo por defecto si LLM_PROVIDER=anthropic (Claude directo o API de Anthropic compatible)
# AGENT_MODEL=claude-sonnet-4-5

# ========== Servidor MCP ==========
# Si quieres el transporte HTTP remoto (SSE o Streamable HTTP):
MCP_SERVER_URL=https://tu-servidor.onrender.com/mcp
MCP_TOKEN=                      # opcional, token Bearer
# stdio (transporte http(s) / SSE deshabilitado, comando local):
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=["dist/examples/echo-server.js"]

# ========== Agente ==========
AGENT_MAX_TOKENS=8192
# Presupuesto de iteraciones POR TURNO (por estímulo del usuario).
AGENT_MAX_ITERATIONS=10
# Rol del agente: archivo markdown (task.md) con las instrucciones de rol.
# Si no se define, usa ./task.md si existe.
# AGENT_TASK_FILE=./task.md
# Alternativa: definir el rol directamente en el entorno (tiene prioridad).
# AGENT_SYSTEM_PROMPT=Eres un agente que procesa los estímulos del usuario y ejecuta acciones vía MCP.

# ========== Canal de entrada (desacoplado del medio) ==========
# Medio físico por el que llegan los estímulos del usuario.
# Hoy soportado: stdio (terminal). Futuro: http, ws, ...
AGENT_CHANNEL=stdio

# ========== BFF / Orquestador (src/backend/server.ts) ==========
# API REST + SSE que expone al agente hacia el frontend.
BFF_HOST=0.0.0.0
BFF_PORT=4000
# Snapshot JSON opcional de sesiones (si se omite, todo vive en memoria).
# BFF_STORE_FILE=./data/sessions.json

# Base de datos compartida (CSV): carpeta con transacciones.csv,
# usuarios_bancario.csv y tarjetas.csv. Por defecto: ../data (junto al motor).
# DATA_DIR=../data

# Registro multi-server MCP, patrón MCP_<SERVER_ID>_URL|TOKEN|TRANSPORT.
# <SERVER_ID> se usa como prefijo de tools ante el LLM: banking.consulta_saldo, impact.analizar...
# Servidor bancario (tools de operación del agente):
MCP_BANKING_URL=https://tu-server-bancario.onrender.com/mcp
MCP_BANKING_TOKEN=
# MCP_BANKING_TRANSPORT=sse   # o streamable-http (auto por defecto)

# Motor de detección de impacto financiero (detonante de conversaciones):
MCP_IMPACT_URL=https://tu-motor-impacto.onrender.com/mcp
MCP_IMPACT_TOKEN=
# MCP_IMPACT_TRANSPORT=
